<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.jtsirogiannos</groupId>
        <artifactId>sftp-client-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>
    <artifactId>sftp-client-spring-boot-starter-reactive</artifactId>
    <name>SFTP Client :: Spring Boot Starter :: Reactive</name>
    <description>
        Starter for a WebFlux application: everything the servlet starter provides, plus a Reactor
        facade exposing Mono and Flux.
    </description>

    <!--
      Unlike the servlet starter this one has code — the Reactor adapter — because that adapter must
      not exist on a classpath without Reactor. Keeping it in this jar rather than behind a
      @ConditionalOnClass in the shared auto-configuration means there is no condition to get wrong:
      an MVC application never sees the class at all.

      reactor-core is a plain compile dependency here, exactly as spring-boot-starter-data-redis-reactive
      depends on spring-boot-reactor. Choosing this starter *is* the declaration that Reactor is present.
    -->
    <dependencyManagement>
        <dependencies>
            <!--
              Imported here, not in the root POM. Root-level it would apply to every module in the
              reactor, including the Quarkus ones, where Spring's managed versions override what
              quarkus-bom supplies — which broke rest-assured in the Quarkus integration tests.
              Spring's opinions belong to the Spring modules.
            -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sftp-client-spring-boot-autoconfigure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sftp-provider-mina</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sftp-client-tck</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
