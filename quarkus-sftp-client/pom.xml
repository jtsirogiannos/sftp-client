<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.jtsirogiannos</groupId>
        <artifactId>sftp-client-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>quarkus-sftp-client-parent</artifactId>
    <packaging>pom</packaging>
    <name>Quarkus SFTP Client :: Parent</name>
    <description>
        Quarkus extension, published under this project's own coordinates and namespace.

        Packages were once io.quarkiverse.* in anticipation of donating the extension to Quarkiverse,
        on the reasoning that renaming after release would break every consumer. That was a bet on a
        donation that is no longer planned, and shipping classes in a namespace we do not own is the
        worse end of the trade: it invites a split package if Quarkiverse ever publishes its own
        io.quarkiverse.sftp.*, and it tells users this is an official Quarkiverse extension. Donating
        later would force a groupId change to io.quarkiverse.&lt;repo&gt; anyway, so the rename would
        ride along with a break that is happening regardless.
    </description>

    <modules>
        <module>runtime</module>
        <module>deployment</module>
        <module>jsch</module>
        <module>mina</module>
        <!-- Last: it consumes the bundles above as an application would. -->
        <module>integration-tests</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <!--
              Managed, not applied. Only the integration-tests module is an application that needs
              augmenting; declaring this in <plugins> would attach it to the runtime and deployment
              modules too, which are libraries.
            -->
            <plugins>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
